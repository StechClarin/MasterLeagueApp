# ====================================================================
# FICHIER DE CONFIGURATION ENVIRONNEMENT (.env)
# ====================================================================
# ⚠️ N'ENVOIE JAMAIS ce fichier sur Git. Il est dans .gitignore !
# ====================================================================

# --- DJANGO CONFIGURATION ---
DEBUG=True
SECRET_KEY='django-insecure-dytx7Q-W6Hp2RKU8UNSjLbh3ERE1h3RrgNj-v6MOVPn7Vyj6arAw58AkI0SWWuyLsag'

# --- DATABASE ---
USER=postgres
PASSWORD=postgres
HOST=localhost
PORT=5432
DATABASE_NAME=db_transportpark
DATABASE_URL=postgres://postgres:postgres@localhost:5432/db_transportpark

# --- ADMIN ---
ADMIN_DEFAULT_PASSWORD=admin1234

# --- SECURITY - CORS (Cross-Origin Resource Sharing) ---
# Liste des origines autorisées à accéder à votre API (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.100.107:4200

# --- SECURITY - CSRF (Cross-Site Request Forgery) ---
# Liste des origines de confiance pour les requêtes CSRF (séparées par des virgules)
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.100.107:4200,http://192.168.100.107:8000

# --- SECURITY - ALLOWED HOSTS ---
# Liste des hôtes/domaines autorisés à servir l'application (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.100.107

# --- ETHER NANOS HUB BRIDGE (SYSTEME DOUBLE SERRURE) ---
# Cette clé permet au Hub et à l'Admin Store de piloter la création de tenants ici.
# Sécurité : Elle doit être identique à VITE_HUB_API_KEY dans le frontend Admin.
HUB_API_KEY=ethernanos-hub-secret-2026

# --- SECURITY - HTTPS (Production uniquement - Désactivé en développement) ---
# ⚠️ NE PAS ACTIVER EN DÉVELOPPEMENT LOCAL (sans HTTPS)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
