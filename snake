#!/bin/bash
# -----------------------------------------------------------------
# Notre script "snake", équivalent de "artisan" de Laravel.
#
# Il gère nos raccourcis (install, run, config-server)
# et passe tout le reste directement à manage.py
# (ex: "craft ...", "migrate", "createsuperuser")
# -----------------------------------------------------------------

# Le premier mot que tu tapes après "snake" (ex: "run")
COMMAND=$1

case "$COMMAND" in
    # ---------------------------------
    # NOS RACCOURCIS DE PROJET
    # ---------------------------------
    
    install)
        echo "--- Installation des dépendances depuis requirements.txt ---"
        python3 -m pip install -r requirements.txt --break-system-packages
        ;;

    run)
        echo "--- Lancement du serveur sur http://127.0.0.1:8000 ---"
        ./venv/bin/python3 manage.py runserver
        ;;

    config-server)
        echo "--- Configuration du serveur (automigrate) ---"
        ./venv/bin/python3 manage.py craft automigrate
        "$0" seed:all
        ;;

    help)
        echo "Commandes personnalisées de 'snake' :"
        echo "  \033[36minstall\033[0m        Installe les dépendances (requirements.txt)"
        echo "  \033[36mrun\033[0m            Lance le serveur de développement"
        echo "  \033[36mconfig-server\033[0m  Configure le serveur (automigrate)"
        echo ""
        echo "Toute autre commande (ex: 'craft ...', 'migrate', 'createsuperuser') est passée à manage.py."
        ;;
    seed:all)
        echo "--- Lancement de tous les seeders (Ordre : Access -> Roles -> Data) ---"
        ./venv/bin/python3 manage.py seed_access
        ./venv/bin/python3 manage.py seed_navigation
        ./venv/bin/python3 manage.py seed_roles
        ./venv/bin/python3 manage.py seed_data
        
        echo "--- Tous les seeders sont terminés ---"
        ;;

    updategql)
        echo "--- Génération du code Frontend (GraphQL Codegen) ---"
        
        # 1. Récupérer le token via le script Python (qui print juste le token)
        TOKEN=$(./venv/bin/python3 get_codegen_token.py)
        
        if [ $? -ne 0 ] || [ -z "$TOKEN" ]; then
            echo "Erreur : Impossible de récupérer un token valide pour l'utilisateur 'ethernanos'."
            echo "Vérifiez que cet utilisateur existe (./snake createsuperuser) ou que le script get_codegen_token.py fonctionne."
            exit 1
        fi

        echo "Token récupéré avec succès."

        # 2. Lancer Codegen avec le token
        export JWT_TOKEN="$TOKEN"
        cd frontend
        npm run codegen
        cd ..
        
        # 3. Générer les routes (Type Safe)
        echo "--- Génération des Routes Enum ---"
        ./venv/bin/python3 manage.py start_generate_routes
        
        echo "--- Codegen terminé ---"
        ;;

    # ---------------------------------
    # COMMANDE PAR DÉFAUT
    # ---------------------------------
    *)
        # Si la commande n'est pas connue, on la passe à manage.py
        # Cela inclut TOUTES les commandes "craft"
        ./venv/bin/python3 manage.py "$@"
        ;;
esac